lemma pent_formula_enc60 :
    (:ℝ) ≤ 1 / 2 + 5 * √2 + 5 / (2 * sin (π / 5)) + 5 / (2 * sin (2 * π / 5)) ∧
    1 / 2 + 5 * √2 + 5 / (2 * sin (π / 5)) + 5 / (2 * sin (2 * π / 5)) ≤ (:ℝ) := by
